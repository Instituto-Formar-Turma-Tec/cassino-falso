# ===== Supabase =====
# URL do projeto (painel Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=SUA_URL_DO_SUPABASE
# Chave anon/public (painel Supabase → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLIC
# Chave secret (equivale à service_role no formato novo) — server-only.
# NUNCA exponha no cliente.
SUPABASE_SECRET_KEY=SUA_CHAVE_SECRET

# ===== Sessão (JWT local) =====
JWT_SECRET=dev-secret-key-change-in-production